rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function companyMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower().matches('^[^@]+@amanacapital[.]com$');
    }
    // Existing company IDs and encryption AAD are preserved. Add an explicit
    // domain/ID mapping here when enabling another company in server config.
    match /companies/{company}/{collection}/{document} {
      allow read, write: if companyMember()
        && company == 'ba842cc19f539e46b6ddf9f6a10f541a67a0cd88684384190427856e206c77e1'
        && collection in ['connections', 'state', 'presets'];
    }
    match /users/{uid}/{collection}/{document} {
      allow read, write: if companyMember() && request.auth.uid == uid
        && collection in ['state', 'presets'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
