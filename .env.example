# Default is local SQLite mode. Set hosted for Firebase + Firestore.
KAFKA_BROWSER_MODE=hosted
APP_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=kafka-browser
FIREBASE_AUTH_DOMAIN=kafka-browser.firebaseapp.com
FIREBASE_WEB_APP_ID=1:724882424937:web:d1626a5365eeb9c6f44ef8
FIREBASE_WEB_API_KEY=your-web-api-key
# Local development: use company ADC. Never deploy user ADC credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-company-adc.json
# Optional only for installations whose policies permit service-account keys:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"kafka-browser","client_email":"...","private_key":"..."}
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KAFKA_CREDENTIALS_KEY=your-base64-encoded-32-byte-key
ALLOWED_EMAIL_DOMAINS=amanacapital.com
# Include all bootstrap AND advertised broker hosts. Optional :port; *.domain supported.
KAFKA_ALLOWED_HOSTS=kafka.example.com:9093
