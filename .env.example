# Default is local SQLite mode. Set hosted for Firebase + Firestore.
KAFKA_BROWSER_MODE=hosted
APP_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=amana-kafka-browser
FIREBASE_AUTH_DOMAIN=amana-kafka-browser.firebaseapp.com
FIREBASE_WEB_APP_ID=1:208259125900:web:b68beac76cbbcd36c0a1a9
FIREBASE_WEB_API_KEY=your-web-api-key
# Single-line JSON. Never commit the real service account or encryption key.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"amana-kafka-browser","client_email":"...","private_key":"..."}
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KAFKA_CREDENTIALS_KEY=your-base64-encoded-32-byte-key
ALLOWED_EMAIL_DOMAINS=amanacapital.com
# Include all bootstrap AND advertised broker hosts. Optional :port; *.domain supported.
KAFKA_ALLOWED_HOSTS=kafka.example.com:9093
